# Generic OpenAI-compatible model configuration.
# Fill these values after choosing a provider. Common options:
# - qwen: get an API key from Alibaba Cloud Bailian / DashScope, then use its OpenAI-compatible base URL.
# - deepseek: get an API key from DeepSeek Platform, then use its OpenAI-compatible base URL for chat.
# - zhipu: get an API key from BigModel, then use its OpenAI-compatible base URL.
# - openai: get an API key from OpenAI Platform, then use its OpenAI base URL.
MODEL_PROVIDER=qwen
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=your_openai_compatible_chat_base_url_here
LLM_MODEL=your_chat_model_name_here

# Embeddings can use a different provider/model from the chat LLM.
# DeepSeek does not provide a general embedding API, so keep this as qwen/zhipu/openai if MODEL_PROVIDER=deepseek.
EMBEDDING_PROVIDER=qwen
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=your_openai_compatible_embedding_base_url_here
EMBEDDING_MODEL=your_embedding_model_name_here

OPENWEATHER_API_KEY=your_openweather_api_key_here

# Local runtime database. Override this value for a managed database.
JAKEPILOT_DATABASE_URL=sqlite:///./data/jakepilot.db

# Optional independent HermesRAG knowledge service. Keep disabled to use the
# built-in FAISS consultation path. Prefer username/password for local demos;
# a short-lived bearer token may be supplied instead.
HERMESRAG_ENABLED=false
HERMESRAG_BASE_URL=http://127.0.0.1:8000
HERMESRAG_USERNAME=
HERMESRAG_PASSWORD=
HERMESRAG_BEARER_TOKEN=
HERMESRAG_TIMEOUT_SECONDS=45

# Optional local appointment decision component. Disabled is the safe default.
# Shadow evaluates locally but keeps the remote strong-model parse authoritative.
# Local-first is automatically downgraded to shadow until a formal, promoted
# component report with at least 150 frozen evaluation samples exists.
APPOINTMENT_DECISION_MODE=disabled
APPOINTMENT_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
APPOINTMENT_LOCAL_MODEL=appointment-decision-q4_k_m
APPOINTMENT_LOCAL_TIMEOUT_SECONDS=4
APPOINTMENT_MODEL_EVIDENCE_DIR=artifacts/appointment-model/reports

# Optional Azure OpenAI mode:
# If you set MODEL_PROVIDER=azure or EMBEDDING_PROVIDER=azure, also add the required AZURE_OPENAI_* values.

# To reuse the SuperHermes local embedding service instead:
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_BASE_URL=http://127.0.0.1:11434
